#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

// Bluetooth keys fire only after being held this long.
#define BT_HOLD_MS 3000

/ {
    chosen {
        // Chocofi has 5 columns per side: use ZMK's 36-key Corne layout.
        zmk,physical-layout = &foostan_corne_5col_layout;
    };

    macros {
        // &bt BT_SEL <n>, with n taken from the macro's parameter
        // (a hold-tap forwards only one parameter to its hold binding).
        bt_sel_m: bt_sel_m {
            compatible = "zmk,behavior-macro-one-param";
            #binding-cells = <1>;
            bindings = <&macro_param_1to2 &bt BT_SEL MACRO_PLACEHOLDER>;
        };
    };

    behaviors {
        td_alt_ctrl: td_alt_ctrl {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <200>;
            bindings = <&kp RALT>, <&kp LCTRL>;
        };

        // Bluetooth keys: the action fires only after BT_HOLD_MS of holding.
        // A shorter press, or pressing another key meanwhile, does nothing.
        hold_bt: hold_bt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <BT_HOLD_MS>;
            bindings = <&bt>, <&none>;
        };

        hold_bt_sel: hold_bt_sel {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <BT_HOLD_MS>;
            bindings = <&bt_sel_m>, <&none>;
        };
    };

    // Rendered layout: keymap-drawer/corne.svg (regenerated by scripts/draw-keymap.sh).
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            display-name = "Base";
            bindings = <
&kp Q  &kp W  &kp E     &kp R  &kp T         &kp Y      &kp U  &kp I      &kp O    &kp P
&kp A  &kp S  &kp D     &kp F  &kp G         &kp H      &kp J  &kp K      &kp L    &kp SEMI
&kp Z  &kp X  &kp C     &kp V  &kp B         &kp N      &kp M  &kp COMMA  &kp DOT  &kp FSLH
              &kp LGUI  &mo 2  &kp LSHIFT    &kp SPACE  &mo 1  &td_alt_ctrl
            >;
        };

        lower_layer {
            // Hold the right middle thumb.
            display-name = "Nav";
            bindings = <
&none           &none      &none         &none             &none     &none       &none         &kp UP_ARROW  &none      &none
&kp LEFT_SHIFT  &kp LCTRL  &kp LEFT_ALT  &kp LEFT_COMMAND  &none     &kp ENTER   &kp LEFT      &kp DOWN      &kp RIGHT  &kp BACKSPACE
&none           &none      &none         &none             &none     &none       &kp CAPSLOCK  &none         &none      &none
                           &none         &mo 3             &trans    &kp RSHIFT  &trans        &trans
            >;
        };

        raise_layer {
            // Hold the left middle thumb.
            display-name = "Num";
            bindings = <
&kp NUMBER_1   &kp NUMBER_2          &kp NUMBER_3   &kp NUMBER_4   &kp N5           &kp NUMBER_6          &kp N7     &kp N8            &kp N9             &kp N0
&kp ESCAPE     &kp TAB               &kp LG(GRAVE)  &kp LG(TAB)    &kp LG(LS(T))    &kp BACKSLASH         &kp MINUS  &kp PLUS          &kp EQUAL          &kp UNDERSCORE
&kp LG(LS(Z))  &kp LG(LS(NUMBER_4))  &kp LC(C)      &kp LC(SPACE)  &kp LEFT_ALT     &kp LA(SINGLE_QUOTE)  &kp SQT    &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp GRAVE
                                     &none          &trans         &trans           &kp RSHIFT            &mo 3      &trans
            >;
        };

        layer_3 {
            // Hold both middle thumbs.
            // Bluetooth (hold for BT_HOLD_MS): A = BT_CLR (forget host on current profile), Z X C V B = BT_SEL 0..4.
            display-name = "Fn";
            bindings = <
&kp F1            &kp F2            &kp F3             &kp F4            &kp F5              &kp F6      &kp F7        &kp F8         &kp F9  &kp F10
&hold_bt BT_CLR   &none             &kp C_VOLUME_DOWN  &kp C_VOLUME_UP   &kp K_MUTE          &none       &none         &none          &none   &none
&hold_bt_sel 0 0  &hold_bt_sel 1 0  &hold_bt_sel 2 0   &hold_bt_sel 3 0  &hold_bt_sel 4 0    &kp LG(N0)  &kp LG(PLUS)  &kp LG(MINUS)  &none   &none
                                    &none              &trans            &trans              &kp RSHIFT  &trans        &none
            >;
        };
    };
};
